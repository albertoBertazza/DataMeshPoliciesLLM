package trino.authz

import future.keywords.if
import future.keywords.in

############################################
# DEFAULTS
############################################

default allow := false
default rowFilters := []
default columnMask := {}
default batchColumnMasks := []

############################################
# DEBUG (optional)
############################################

debug_print if {
    print(sprintf("INPUT=%v", [input]))
    false
}

############################################
# USERS
############################################

is_main_admin if {
    input.context.identity.user == "trino"
}

is_admin if {
    input.context.identity.user == "trino_admin"
}

is_service if {
    input.context.identity.user == "etl_pipeline"
}

user_role := input.context.identity.extraCredentials.role if {
    input.context.identity.extraCredentials
}

user_age := to_number(input.context.identity.extraCredentials.age) if {
    input.context.identity.extraCredentials.age
}

is_manager if {
    user_role == "manager"
}

is_adult if {
    user_age > 18
}

############################################
# HARD OVERRIDE (TRINO CAN DO ANYTHING)
############################################

allow if is_main_admin
rowFilters := [] if is_main_admin
columnMask := {} if is_main_admin
batchColumnMasks := [] if is_main_admin

############################################
# SERVICE / ADMIN OVERRIDE
############################################

allow if is_admin
allow if is_service

############################################
# BASIC EXECUTION (SAFE FALLBACK)
############################################

allow if {
    input.action.operation == "ExecuteQuery"
    input.context.identity.user != ""
}

allow if {
    input.action.operation == "AccessCatalog"
    input.action.resource.catalog.name == "iceberg"
}

############################################
# READ OPERATIONS
############################################

read_operations := {
    "SelectFromColumns",
    "GetColumnMask",
    "GetRowFilters"
}

allow if {
    is_manager
    is_adult

    input.action.operation in read_operations

    input.action.resource.table.catalogName == "iceberg"
    input.action.resource.table.schemaName in {"hr", "mobility"}
}

############################################
# SCHEMA ACCESS
############################################

allow if {
    is_manager
    is_adult

    input.action.operation == "AccessSchema"
    input.action.resource.schema.catalogName == "iceberg"
    input.action.resource.schema.schemaName in {
        "hr",
        "mobility",
        "information_schema"
    }
}

allow if {
    input.action.operation == "FilterSchemas"
    input.action.resource.schema.catalogName == "iceberg"
}

allow if {
    input.action.operation == "FilterTables"
    input.action.resource.table.catalogName == "iceberg"
}

############################################
# TABLE ACCESS
############################################

allow if {
    is_manager
    is_adult

    input.action.operation == "ShowTables"
    input.action.resource.schema.catalogName == "iceberg"
    input.action.resource.schema.schemaName in {"hr", "mobility"}
}

############################################
# ROW FILTERS (HR ONLY)
############################################

rowFilters := [
    {
        "expression": "trim(attrition) <> 'Yes'"
    }
] if {
    not is_main_admin
    not is_admin

    input.action.resource.table.catalogName == "iceberg"
    input.action.resource.table.schemaName == "hr"
    input.action.resource.table.tableName == "employees"
}

############################################
# COLUMN MASKS (MOBILITY ONLY)
############################################

columnMask := {
    "expression": "0"
} if {
    not is_main_admin
    not is_admin

    input.action.resource.column.catalogName == "iceberg"
    input.action.resource.column.schemaName == "mobility"
    input.action.resource.column.tableName == "taxi_trips"
    input.action.resource.column.columnName == "passenger_count"
}

columnMask := {
    "expression": "date_trunc('day', tpep_dropoff_datetime)"
} if {
    not is_main_admin
    not is_admin

    input.action.resource.column.catalogName == "iceberg"
    input.action.resource.column.schemaName == "mobility"
    input.action.resource.column.tableName == "taxi_trips"
    input.action.resource.column.columnName == "tpep_dropoff_datetime"
}

############################################
# BATCH (SAFE DEFAULT)
############################################

batchColumnMasks := [] if {
    not is_main_admin
    not is_admin
}